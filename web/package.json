{
  "name": "winmate-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Winmate 웹 — 셸(web/src/shell) + 기능 모듈(web/src/features/<기능>)",
  "scripts": {
    "dev": "vite --port 5001 --strictPort",
