# ─────────────────────────────────────────────────────────────────────────────
# Winmate — 환경 변수 템플릿
#
#   cp .env.example .env  →  [필수] 항목만 채우면 맥 개발 환경이 돈다(make up).
#   .env 는 커밋하지 않는다. 키 값은 로그 · 보고서 · 프롬프트에 남기지 않는다.
#
# 원칙
#   1. 외부 모델은 ai-tools 서비스(5010)만 부른다. 기능(LLM · I2T · T2I · WEBSEARCH)마다
#      <기능>_PROVIDER 로 제공자를 고른다: gemini · openai_compat · internal · mock.
#      개발(맥)은 Gemini 최저 등급, 사내망은 이 파일의 값만 사내 API 로 바꾼다 → docs/MIGRATION.md
#   2. <기능>_SUPPORTS_* 는 "이 API 가 그 기능을 지원하는가". false 면 ai-tools 가 같은 응답 모양의
#      대체 경로(JSON 프롬프트 + 수리 · ReAct · 잘라 붙이기 …)로 돈다. 개발 중 false 로 바꿔 미리 시험할 수 있다.
#   3. 기밀(고객 자료)은 <기능>_ALLOW_CONFIDENTIAL=true 인 제공자로만 간다. Gemini(외부)는 전부 false.
#   4. 저장은 서비스별 SQLite + 로컬 파일(DATA_DIR), 잡 큐는 Redis(5379, pm2 가 띄움). Docker 없음.
#   5. 포트는 config/services.yaml 이 단일 원천이다(이 파일에서 정하지 않는다).
#   6. 서비스 프로세스는 시작할 때 이 파일을 한 번 읽는다 → 고치면 `make restart`.
#      같은 이름의 셸 환경 변수가 있으면 그 값이 이긴다. 빈 값 = 값 없음(코드 기본값).
#   7. 값 뒤에 # 주석을 붙이지 않는다(pm2 설정 파일이 APP_HOST · JOB_WORKERS 를 줄 그대로 읽는다).
#
# 표시: [필수] 지금 채움 · [사내] 사내망 이전 때 바꿀 값 · [선택] 비워도 동작
# ─────────────────────────────────────────────────────────────────────────────


# ── 0. Gemini (개발용 대체 API) ─────────────────────────────────────────────
# [필수] Google AI Studio 에서 발급(https://aistudio.google.com/apikey).
#        이미지 생성 모델은 무료 등급이 없으므로 결제가 켜진 프로젝트의 키여야 한다.
#        <기능>_API_KEY 가 비어 있으면 Gemini 제공자는 이 키를 쓴다.
GEMINI_API_KEY=
# Gemini 제공자의 주소(사내 중계 프록시가 Gemini API 모양 그대로 받으면 그 주소). <기능>_BASE_URL 은 openai_compat 용
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# Gemini 3 계열 추론 깊이: minimal | low | medium | high. 비우면 보내지 않는다(모델 기본값).
# 모델이 받지 않으면 400 → 비운다. 사내 소형 모델 수준에 가깝게 낮게 둔다.
GEMINI_THINKING_LEVEL=low


# ── 1. 실행 모드 ────────────────────────────────────────────────────────────
# dev(맥) | intranet(사내망)  [사내]
# dev 면 서비스 간 계약 검증 기본값이 strict(어긋나면 오류), 그 밖은 warn(로그만)
WINMATE_ENV=dev
# live   실제 호출
# mock   결정적 가짜 응답(네트워크 없음, Redis 한도 안 씀). mocks/ai-tools/<task>.json 이 있으면 그 응답
# record 실제 호출 + 응답 저장   → 맥에서 Gemini 응답을 쌓아 두고
# replay 저장된 응답만 사용      → 사내 이전 뒤 비교 · 회귀에 쓴다(docs/MIGRATION.md §7)
MODEL_MODE=live
MODEL_CASSETTE_DIR=./data/cassettes
# replay 에서 카세트가 없을 때: 비우면 404 CASSETTE_MISS | mock 이면 mock 응답으로
REPLAY_FALLBACK=
# mock 은 밖으로 나가는 것이 없어 기밀 호출을 막지 않는다. true 면 mock 도 *_ALLOW_CONFIDENTIAL 대로 403
MOCK_ENFORCE_CONFIDENTIAL=false
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO


# ── 2. 웹 · 로그인 ─────────────────────────────────────────────────────────
# 게이트웨이(5000)가 듣는 주소. 로컬만 127.0.0.1 / 사내망 공유 0.0.0.0  [사내]
# 다른 서비스는 언제나 127.0.0.1 에서만 듣는다. 바꾸면 `make down && make up`(pm2 가 시작할 때 읽음)
APP_HOST=127.0.0.1
# 세션 쿠키 서명 키. 비우면 첫 실행 때 data/.secret_key 에 만든다
APP_SECRET_KEY=
# none 로그인 없음(모든 접속자가 아래 개발 사용자) | local 로컬 계정  [사내]
# local 이면 웹 /login 화면 · 사용자 메뉴 「사용자 관리」(/admin/users). 켜는 법: docs/OPERATIONS.md 2.5
AUTH_MODE=none
# AUTH_MODE=none 일 때 쓰는 사용자(id · 화면 이름 · 소속)
DEV_USER_ID=u_dev
DEV_USER_NAME=개발자
DEV_USER_ORG=
# AUTH_MODE=local 에서 쓸 수 있는 관리자가 없으면 시작할 때 만드는 관리자 계정(같은 아이디가 있으면 관리자로 올림)  [사내]
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# 업로드 · 요청 본문 한도(MB). 게이트웨이(+5MB 여유)와 files 서비스가 같이 쓴다
UPLOAD_MAX_MB=50
# 워커 프로세스(export · 기능 서비스마다 1개)가 동시에 처리하는 잡 수. pm2 가 JOB_CONCURRENCY 로 넘긴다
# 바꾸면 `make down && make up`
JOB_WORKERS=2
# 참고: Redis 실행 파일 · 일부 서비스만 띄우기 같은 pm2 설정은 이 파일이 아니라 `make up` 하는 셸의 환경 변수다
#       (REDIS_SERVER_BIN · REDIS_MANAGED · WINMATE_ONLY · WINMATE_WEB_DEV · WINMATE_VENV_BIN — docs/OPERATIONS.md)


# ── 3. 저장 경로 ────────────────────────────────────────────────────────────
# 서비스마다 DATA_DIR/<서비스>/ 에 SQLite · 파일(files 서비스는 blobs/). 상대 경로는 저장소 루트 기준
# (pm2 로그 data/logs · Redis data/redis 는 저장소 루트의 data/ 로 고정)
DATA_DIR=./data
# ai-tools 웹 수집 디스크 캐시
CACHE_DIR=./data/cache
# 지식 DB(winmate-kb). 비우면: WKB_ROOT=winmate-kb · WKB_KB=<WKB_ROOT>/kb ·
#   WKB_THUMBS_DIR=<WKB_ROOT>/dashboard/build · WKB_IMAGE_DIR=<DATA_DIR>/kb/images
WKB_ROOT=
WKB_KB=./winmate-kb/kb
WKB_THUMBS_DIR=
WKB_IMAGE_DIR=
# 0 이면 kb 서비스가 시작할 때 미리 데우지 않는다(첫 질의가 5~11초 느려짐)
KB_WARMUP=1


# ── 4. LLM (텍스트 생성) ────────────────────────────────────────────────────
# gemini | openai_compat(사내 API 가 OpenAI 호환일 때, 별칭 openai) | internal(전용 어댑터) | mock  [사내]
LLM_PROVIDER=gemini
# openai_compat · internal 의 엔드포인트(openai_compat 예 http://<사내 LLM>/v1 — 뒤에 /chat/completions 가 붙는다).
# I2T · T2I · WEBSEARCH 의 _BASE_URL · _API_KEY 도 같은 뜻  [사내]
LLM_BASE_URL=
# 비우면: gemini → GEMINI_API_KEY, openai_compat → 키 없이(Bearer not-needed)  [사내]
LLM_API_KEY=
# 가장 낮은 등급(Flash-Lite)  [사내]
LLM_MODEL=gemini-3.1-flash-lite
# 앱이 스스로 지키는 상한. 입력은 글자 수로 추정해 넘으면 413 CONTEXT_TOO_LONG  [사내]
LLM_MAX_INPUT_TOKENS=32000
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TEMPERATURE=0.2
# 원칙 2. false 면 JSON 프롬프트 + 수리 / ReAct 텍스트 / 한 번에 받기로 대체  [사내]
LLM_SUPPORTS_JSON_SCHEMA=true
LLM_SUPPORTS_TOOLS=true
LLM_SUPPORTS_STREAMING=true
# 호출 1회 제한 시간(초). JSON 수리는 최대 2번 더 부르므로 3배가 300초를 넘지 않게  [사내]
LLM_TIMEOUT_S=90
# ai-tools 안 동시 호출 수
LLM_MAX_CONCURRENCY=4
# 분당 · 하루 호출 상한(0 = 무제한). live · record 에서만 센다(Redis). 키 등급과 사내 한도에 맞춘다  [사내]
LLM_RPM=30
LLM_DAILY_LIMIT=2000


# ── 5. I2T (이미지 → 텍스트) ────────────────────────────────────────────────
# 이미지 등급 · 공간 판정, 도면 · 현장 사진 인식, 슬라이드 이해, 로고 · 인물 검사
# gemini | openai_compat | internal | mock  [사내]
I2T_PROVIDER=gemini
I2T_BASE_URL=
I2T_API_KEY=
I2T_MODEL=gemini-3.1-flash-lite
I2T_MAX_OUTPUT_TOKENS=4096
I2T_TEMPERATURE=0.2
# 호출당 이미지 수(넘으면 400 TOO_MANY_IMAGES), 보낼 때 긴 변 최대 px(LLM 대화 속 이미지에도 적용)  [사내]
I2T_MAX_IMAGES_PER_CALL=4
I2T_MAX_IMAGE_SIDE_PX=1536
I2T_SUPPORTS_JSON_SCHEMA=true
# 좌표(bbox) 출력. false 면 boxes=[] + 경고  [사내]
I2T_SUPPORTS_BBOX=true
# 모델이 내는 박스 좌표 규약: gemini_yxyx_1000 | xyxy_1000 | xyxy_norm | xyxy_px(보낸 이미지 픽셀)  [사내]
I2T_BBOX_FORMAT=gemini_yxyx_1000
I2T_TIMEOUT_S=90
I2T_MAX_CONCURRENCY=4
I2T_RPM=30
I2T_DAILY_LIMIT=3000


# ── 6. T2I (텍스트 → 이미지 · 편집) ─────────────────────────────────────────
# gemini | openai_compat | internal | mock  [사내]
T2I_PROVIDER=gemini
T2I_BASE_URL=
T2I_API_KEY=
# 가장 낮은 등급(Nano Banana 2 Lite). 1K 해상도만, 마스크 인페인팅 없음  [사내]
T2I_MODEL=gemini-3.1-flash-lite-image
T2I_DEFAULT_ASPECT=16:9
# 생성 원본의 긴 변 상한(image 서비스의 기본 렌디션 크기도 이 값). 2K · 4K 는 업스케일 단계에서  [사내]
T2I_MAX_SIDE_PX=1024
# 참조 이미지(제품 단독컷 등)를 넣을 수 있는가. false 면 참조를 빼고 생성(references_dropped)  [사내]
T2I_SUPPORTS_REFERENCE_IMAGES=true
T2I_MAX_REFERENCE_IMAGES=4
# 이미지 + 지시문 → 수정본. false 면 참조 생성으로 대신(edit_as_generate), 참조도 안 되면 501  [사내]
T2I_SUPPORTS_EDIT=true
# 마스크 지정 부분 수정(openai_compat 만 고유 마스크). false 면 영역을 잘라 수정 후 붙이기(mask_crop_paste)  [사내]
T2I_SUPPORTS_MASK=false
# 호출 한 번에 받는 장 수. 4안 생성은 이 값으로 나눠 반복 호출  [사내]
T2I_IMAGES_PER_CALL=1
# openai_compat 응답 형식: b64_json(기본) | none(보내지 않음 — gpt-image 계열)  [사내]
T2I_RESPONSE_FORMAT=b64_json
# openai_compat 크기 고정(예 1024x1024). 비우면 비율 × T2I_MAX_SIDE_PX(64 배수)로 계산  [사내]
T2I_SIZE=
T2I_TIMEOUT_S=120
T2I_MAX_CONCURRENCY=2
T2I_RPM=0
# 하루 생성 장수 상한(비용 가드, 실패한 호출은 되돌린다)
T2I_DAILY_LIMIT=100


# ── 7. WEBSEARCH (요약형 웹 검색) ───────────────────────────────────────────
# 사내 검색 API 는 원문이 아니라 LLM 요약문을 돌려준다. 지금은 Gemini 의 Google 검색 그라운딩으로 같은 형태를 흉내 낸다.
# gemini_grounding | openai_compat | internal | mock  [사내]
# (모르는 값은 501 NOT_CONFIGURED — 사실상 끔)
WEBSEARCH_PROVIDER=gemini_grounding
WEBSEARCH_BASE_URL=
WEBSEARCH_API_KEY=
# 그라운딩을 지원하는 모델 중 가장 낮은 등급(3.1 Flash-Lite 는 지원 목록에 없음)
WEBSEARCH_MODEL=gemini-3.5-flash-lite
# false 사내와 똑같이 요약문만 앱에 넘김(출처 URL 버림, 카세트에는 남김) | true 출처 URL 도 넘김
# 사내 결과에 출처가 오는지 확인되면 맞춘다  [사내]
WEBSEARCH_RETURN_SOURCES=false
WEBSEARCH_MAX_OUTPUT_TOKENS=2048
WEBSEARCH_TEMPERATURE=0.2
WEBSEARCH_TIMEOUT_S=60
WEBSEARCH_MAX_CONCURRENCY=2
WEBSEARCH_RPM=0
# 그라운딩 무료 한도가 월 5,000건이라 하루 150건 정도로 둔다  [사내]
WEBSEARCH_DAILY_LIMIT=150


# ── 8. 검색 API(원문 URL) · 웹 수집 [선택] ─────────────────────────────────
# 요약형 검색만으로 부족한 출처 · 원문 확인용. 지금은 검색 API 없이(none → available=false) 개발한다.
# none | brave | tavily | serper | google_cse | searxng | internal | mock  [사내]
SEARCH_API_PROVIDER=none
# 공급사 기본 주소를 바꿀 때 · searxng 주소 · internal 은 POST 받을 전체 URL  [사내]
SEARCH_API_BASE_URL=
SEARCH_API_KEY=
# google_cse 검색 엔진 ID
SEARCH_API_CX=
SEARCH_API_TIMEOUT_S=20
# 검색 결과 URL 의 본문을 직접 가져오는 수집기. 사내망에서 외부 웹이 막혀 있으면 false  [사내]
WEB_FETCH_ENABLED=true
WEB_FETCH_USER_AGENT=WinmateBot/0.1
WEB_FETCH_RESPECT_ROBOTS=true
# 같은 호스트 초당 요청 수(0.5 = 2초 간격)
WEB_FETCH_RATE_LIMIT_RPS=0.5
WEB_FETCH_TIMEOUT_S=20
WEB_FETCH_CACHE_TTL_HOURS=168
# 한 페이지 최대 바이트(5MB)
WEB_FETCH_MAX_BYTES=5242880
# 쉼표로 구분. 비우면 제한 없음
WEB_FETCH_ALLOWED_DOMAINS=


# ── 9. 임베딩 [선택] ───────────────────────────────────────────────────────
# lsa(기본)   ai-tools /embed 는 501 EMBEDDING_DISABLED — kb 서비스는 winmate-kb 자체 LSA 를 쓴다
# openai_compat  EMBEDDING_BASE_URL 의 /embeddings  [사내]
# local       sentence-transformers(지금 미설치 → 501) · internal(자리, 501) · none · mock
EMBEDDING_PROVIDER=lsa
EMBEDDING_MODEL=BAAI/bge-m3
# local 일 때 가중치 폴더(있으면 EMBEDDING_MODEL 대신)
EMBEDDING_MODEL_PATH=./models/bge-m3
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# 차원(비우면 알려진 모델 표에서)
EMBEDDING_DIM=
EMBEDDING_TIMEOUT_S=60
# cpu | mps(맥) | cuda — local 임베딩만
LOCAL_MODEL_DEVICE=cpu
# local 임베딩을 쓸 때만(huggingface 라이브러리가 읽는다). 사내망은 HF_HUB_OFFLINE=1
# HF_HOME=./models/hf
# HF_HUB_OFFLINE=1


# ── 10. 문서 도구 (로컬) ───────────────────────────────────────────────────
# LibreOffice 실행 파일. PPTX → PDF · 슬라이드 PNG(export), 문서 썸네일 · 쪽 그림 · 옛 형식(files)  [사내]
#   맥 /Applications/LibreOffice.app/Contents/MacOS/soffice · 우분투 /usr/bin/soffice · off(끔)
#   비우면 files 는 PATH(맥은 기본 위치)에서 찾고, export 는 PDF 변환을 끈다(501 PDF_CONVERTER_UNAVAILABLE)
SOFFICE_PATH=
# files 서비스의 LibreOffice 변환 제한 시간 · 동시 실행 수
SOFFICE_TIMEOUT_S=180
SOFFICE_CONCURRENCY=1
# files 파싱 동시 수 · pdfplumber 로 읽는 최대 쪽 수 · 문서 하나에서 뽑는 자식 파일(그림 · 첨부) 상한
FILES_PARSE_CONCURRENCY=2
FILES_PDF_LAYOUT_MAX_PAGES=300
FILES_MAX_CHILDREN=300
# 자리표시 카드 · 아이콘 글꼴(비우면 Noto CJK → 나눔 → fc-match :lang=ko 순)
FILES_FONT_PATH=
# 이 장수 · 항목 수까지는 export API 가 바로 만들고(201), 넘으면 잡(202)
EXPORT_SYNC_MAX_SLIDES=40
EXPORT_SYNC_MAX_ZIP=40
# 보고서형 PDF 에 넣을 TTF(비우면 reportlab 내장 CID 글꼴). 예 /usr/share/fonts/truetype/nanum/NanumGothic.ttf
EXPORT_PDF_TTF=


# ── 11. 데이터 정책 ─────────────────────────────────────────────────────────
# 기밀(과거 제안서 · 고객 RFP · 사내 자료)을 이 기능의 제공자로 보내도 되는가. false 면 403 POLICY_CONFIDENTIAL.
# Gemini 는 외부 서비스라 전부 false. 사내 모델로 바꾼 기능만 사내 정책대로 true  [사내]
LLM_ALLOW_CONFIDENTIAL=false
I2T_ALLOW_CONFIDENTIAL=false
T2I_ALLOW_CONFIDENTIAL=false
WEBSEARCH_ALLOW_CONFIDENTIAL=false
# 모델 호출 로그(data/ai-tools/calls.sqlite): full(프롬프트 · 응답 본문) | meta(시간 · 토큰 · 상태만) | off  [사내]
MODEL_CALL_LOG=full
MODEL_CALL_LOG_RETENTION_DAYS=30


# ── 12. 내부 연결 (보통 비움) ──────────────────────────────────────────────
# 비우면 redis://127.0.0.1:<config/services.yaml redis 포트 5379>/0
REDIS_URL=
# 서비스끼리 부르는 게이트웨이 주소. 비우면 http://127.0.0.1:5000
GATEWAY_URL=
# 서비스 간 내부 토큰. 비우면 첫 실행 때 data/.internal_token 에 만든다
INTERNAL_TOKEN=
# 서비스 간 호출 계약 검증: strict | warn | off. 비우면 WINMATE_ENV 에 따라(dev=strict, 그 밖=warn)
CONTRACT_VALIDATION=
# 0 이면 jobs 서비스의 예약 실행(30일 재확인 등)을 끈다
JOBS_SCHEDULER=1


# ── 13. 네트워크 [사내] ─────────────────────────────────────────────────────
# 필요할 때만 주석을 풀어 쓴다(빈 값으로 두면 일부 HTTP 라이브러리가 오동작).
# 프록시를 쓰면 NO_PROXY 에 로컬 주소를 꼭 넣는다 — 서비스끼리 127.0.0.1:5000 으로 부른다.
# HTTP_PROXY=http://proxy.example:8080
# HTTPS_PROXY=http://proxy.example:8080
# NO_PROXY=localhost,127.0.0.1,::1
# 사내 사설 인증서: 이 파일이 기본 CA 묶음을 "대체"한다 → 시스템 묶음(사내 CA 를 update-ca-certificates 로 넣은 것)을 가리킨다
# SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
# REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt


# ── 14. 기능 서비스 [선택] ─────────────────────────────────────────────────
# 비우면 각 서비스의 기본값(괄호 안). 뜻 · 근거는 services/<서비스>/AGENTS.md · docs/scenarios/
# requirements — 파일로 채우기에서 칸을 하나 채울 때마다 쉬는 시간(ms, 150)
RQ_FILL_SLOT_DELAY_MS=
# storyboard — mock 시연 · e2e 진행 화면 속도(초, mock 이면 0.45 · 실제 모델이면 0). 0 = 바로
SB_PACE_S=
# competitor — 묻기 1(고객사 · 장소)을 업종이 애매할 때만(true) · 동시 분석 경쟁사 수(2) · 넣기 읽기 LLM 제한(초, 8 — 넘으면 KB 로만)
CA_ASK_SLOTS_REQUIRE_AMBIGUOUS_INDUSTRY=
CA_ANALYZE_CONCURRENCY=
CA_PARSE_TIMEOUT_S=
# vp — 생성 단계 사이 쉬는 시간(초, 0 — 시연용)
VP_PACE_S=
# scenario — 장면 하나 쓰기 전 쉬는 시간(초, 0 — 시연 · SC4G 진행 화면) · LLM 503/504 다시 시도 간격(초, 쉼표 1,3)
SC_PACE_S=
SC_LLM_RETRY_DELAYS=
# birdseye — 휴대폰 QR 주소 앞부분(휴대폰이 닿는 PC 주소, 예 http://192.168.0.10:5000 — 비우면 상대 경로라 QR 을 못 쓴다)  [사내]
PUBLIC_BASE_URL=
# birdseye — LLM 제한(초, 60) · 렌더 확인 간격(초, 0.5) · 렌더 제한(초, 900) · 503 재시도 간격(초, 2,6) · 추가 컷 자동(비우면 config/rules.yaml)
BE_LLM_TIMEOUT_S=
BE_RENDER_POLL_S=
BE_RENDER_TIMEOUT_S=
BE_RETRY_DELAYS=
AUTO_EXTRA_CUTS=
# mi — 홈에 먼저 보일 업종 코드(쉼표, 비우면 services/mi/config/segments.yaml) · 정리 단계 동시 수(2)
MI_HOME_SEGMENTS=
MI_ORGANIZE_CONCURRENCY=
# spec — 카탈로그 어댑터 kb(기본) | fixture(시험) · 파생 행 "연간 전기료(추정)" 단가(원/kWh, 비우면 값 확인 필요로 둔다)
SPEC_CATALOG_ADAPTER=
SPEC_ELECTRICITY_KRW_PER_KWH=
# image — 동시 실행: image 워커 동시 job(2) · 가벼운 잡(사진 인식 · 참조 분석 · 내보내기, 2) · 사용자당 진행 run(1) · run 안 동시 시안(2)
IMAGE_WORKER_CONCURRENCY=
IMAGE_LIGHT_CONCURRENCY=
IMAGE_MAX_RUNNING_PER_USER=
IMAGE_SHOT_CONCURRENCY=
# image — 품질 확인: 실패 시 재생성(1) · 제품 매칭 최소 신뢰도(0.6) · 제품 박스 비율 오차(0.15) ·
#   변형 배치 유지 IoU(0.5) · 전체 수정 제품 유지 IoU(0.8) · 합성 뒤 제품 형태 IoU(0.9)
QC_MAX_RETRY=
PRODUCT_MATCH_MIN=
PRODUCT_ASPECT_TOL=
VARIANT_LAYOUT_IOU_MIN=
GLOBAL_EDIT_PRODUCT_IOU_MIN=
COMPOSITE_EDGE_IOU_MIN=
# image — 합성: 붙이기 페더(8px) · 보정 링(16px) · 어두움 판정 휘도(0.22) · 제품 단독컷 참조 최대(2)
FEATHER_PX=
SEAM_RING_PX=
IMAGE_DARK_LUMA=
PRODUCT_REF_MAX=
# image — 업스케일: none | realesrgan_x4v3(ONNX 모델 파일 + onnxruntime 필요 — 지금 의존성에 없어 none 으로 동작)
UPSCALER=
UPSCALER_MODEL_PATH=
# image — 시간: prefill 제한(10초) · 그 안 LLM 제한(8초) · 일시 오류 재시도 간격(초, 쉼표 2,6) · 시안 1장 예상 시간(25초, 진행 표시)
IMAGE_PREFILL_TIMEOUT_S=
IMAGE_LLM_TIMEOUT_S=
IMAGE_RETRY_DELAYS=
IMAGE_DEFAULT_SHOT_S=
# 시험 · 개발용(.env 에 두지 않는다): AI_TOOLS_MOCKS_DIR · IMAGE_DEV_SHOT_DELAY_S · MI_CONFIG_DIR · MI_TODAY · CA_TODAY · BE_RENDER_TARGET ·
#   SPEC_CONFIG_DIR · SPEC_CATALOG_FIXTURE · SPEC_FIXED_NOW · SPEC_WARRANTY_FILE · SPEC_LIFECYCLE_FILE · SPEC_COMBOS_FILE
# 프로세스가 정하는 값(.env 에 두지 않는다): WINMATE_SERVICE · JOB_CONCURRENCY(pm2 가 JOB_WORKERS 로) · WINMATE_ROOT ·
#   WINMATE_ENV_FILE · WINMATE_CONTRACT_EXPORT · LIVE_CHECK_TRACE


# ── 이전 .env 에서 바뀐 키 ─────────────────────────────────────────────────
# 이미 채운 .env 는 아래만 손보면 된다(그 밖의 키 이름 · 뜻은 그대로).
#
# 지움 — 코드가 읽지 않는다(남겨 둬도 무시되지만 지우는 편이 헷갈리지 않는다)
#   APP_PORT                    포트는 config/services.yaml(게이트웨이 5000, 웹 개발 서버 5001)
#   APP_BASE_URL                아직 읽는 코드가 없다(공유 링크는 상대 경로 /share/<token>) — OPERATIONS.md §4
#   APP_DB_PATH · ASSET_DIR · EXPORT_DIR   서비스마다 DATA_DIR/<서비스>/ 에 저장(파일 · 내보내기 결과는 files 서비스)
#   OCR_PROVIDER · TESSERACT_CMD           글자 층 없는 PDF · 이미지는 기능 서비스가 ai-tools I2T 로 읽는다
#   UPLOAD_DEFAULT_CONFIDENTIAL            업로드 요청(화면)의 confidential 값으로 정한다(API 기본 false)
#   RERANKER_PROVIDER · RERANKER_MODEL · RERANKER_MODEL_PATH   리랭커 없음
#   LIVE_TESTS                  실제 점검은 services/ai-tools/scripts/live_check.py
#   HF_HOME · HF_HUB_OFFLINE    주석으로 옮김(로컬 임베딩을 쓸 때만)
# 뜻이 바뀜
#   JOB_WORKERS                 SQLite 큐가 아니라 Redis 잡 큐 — 워커 프로세스(export · 기능 서비스마다 1개)당 동시 잡 수
#   WEBSEARCH_PROVIDER          none 대신 모르는 값 = 501(사실상 끔). openai_compat · mock 도 된다
#   SEARCH_API_PROVIDER         mock 추가 · EMBEDDING_PROVIDER  openai_compat · internal · mock 추가
#   SOFFICE_PATH                off 로 끌 수 있다. 비우면 files 만 자동으로 찾는다(export 는 경로가 있어야 함)
#   CACHE_DIR                   ai-tools 웹 수집 캐시만(files 캐시는 DATA_DIR/files/cache 고정)
# 새로 생김
#   REPLAY_FALLBACK · MOCK_ENFORCE_CONFIDENTIAL · DEV_USER_ID · DEV_USER_ORG · WKB_ROOT · WKB_THUMBS_DIR ·
#   WKB_IMAGE_DIR · KB_WARMUP · I2T_MAX_OUTPUT_TOKENS · I2T_TEMPERATURE · I2T_BBOX_FORMAT · T2I_RPM ·
#   T2I_RESPONSE_FORMAT · T2I_SIZE · WEBSEARCH_MAX_OUTPUT_TOKENS · WEBSEARCH_TEMPERATURE · WEBSEARCH_MAX_CONCURRENCY ·
#   WEBSEARCH_RPM · SEARCH_API_CX · SEARCH_API_TIMEOUT_S · WEB_FETCH_MAX_BYTES · EMBEDDING_BASE_URL · EMBEDDING_API_KEY ·
#   EMBEDDING_DIM · EMBEDDING_TIMEOUT_S · SOFFICE_TIMEOUT_S · SOFFICE_CONCURRENCY · FILES_PARSE_CONCURRENCY ·
#   FILES_PDF_LAYOUT_MAX_PAGES · FILES_MAX_CHILDREN · FILES_FONT_PATH · EXPORT_SYNC_MAX_SLIDES · EXPORT_SYNC_MAX_ZIP ·
#   EXPORT_PDF_TTF · REDIS_URL · GATEWAY_URL · INTERNAL_TOKEN · CONTRACT_VALIDATION · JOBS_SCHEDULER ·
#   §14 기능 서비스 키 전부
